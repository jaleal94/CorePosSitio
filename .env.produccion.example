# Las variables que hay que cargar en Vercel, en Settings -> Environment
# Variables, marcadas para Production (y para Preview si quiere previsualizar).
#
# Este archivo es una referencia. No se copia a ningun sitio ni se sube: en
# Vercel los valores se escriben en su panel, y en GitHub en los secretos.

# Que configuracion usar. La de Vercel hereda de prod.py.
DJANGO_SETTINGS_MODULE=config.settings.vercel

# Obligatoria y sin valor por omision: si falta, la aplicacion no arranca.
DJANGO_DEBUG=False

# Generela con:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Si empieza por "dev-inseguro", el codigo se niega a arrancar.
DJANGO_SECRET_KEY=

# Sus dominios, separados por coma y SIN https://
DJANGO_ALLOWED_HOSTS=corepos.com.ve,www.corepos.com.ve,core-pos-sitio.vercel.app

# Los mismos, CON https://. Sin esto el formulario de contacto da 403.
DJANGO_CSRF_TRUSTED_ORIGINS=https://corepos.com.ve,https://www.corepos.com.ve,https://core-pos-sitio.vercel.app

# ---------------------------------------------------------------- la base
#
# Tiene que ser la cadena del **agrupador en modo transaccion**, por dos
# razones distintas que coinciden en la misma cadena:
#
#   1. En Vercel cada peticion abre su propia conexion. Sin agrupador, un rato
#      de visitas agota las conexiones de la base.
#   2. Bastantes proveedores de internet bloquean el puerto 5432. El agrupador
#      de transacciones escucha en otro puerto y por ahi si se puede migrar
#      desde una maquina cualquiera.
#
# En Supabase: Project Settings -> Database -> Connection string ->
# **Transaction pooler**. El anfitrion termina en `pooler.supabase.com` y el
# puerto es 6543. Agreguele `?sslmode=require` al final si no lo trae.
#
# El usuario no es `postgres` a secas: lleva el identificador del proyecto
# detras de un punto.
DATABASE_URL=postgresql://postgres.abcdefghijkl:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# ---------------------------------------------------------------- la marca
#
# A donde escriben los interesados, en formato internacional y sin signos.
CORE_POS_WHATSAPP=584140000000
CORE_POS_CORREO=hola@corepos.com.ve

# La direccion del sistema, para los botones de "entrar" y "pedir mi tienda".
CORE_POS_APP_URL=https://app.corepos.com.ve

DJANGO_TIME_ZONE=America/Caracas
DJANGO_LOG_LEVEL=INFO
