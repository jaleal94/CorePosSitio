# Copiar a .env y ajustar. El archivo .env nunca se versiona.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-inseguro-cambiar-en-produccion
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Caracas

# PostgreSQL local. Crear con:  createdb -U postgres coreposweb
DATABASE_URL=postgres://postgres:TU_CLAVE_AQUI@localhost:5432/coreposweb

# A donde escriben los interesados, en formato internacional sin signos.
CORE_POS_WHATSAPP=584140000000
CORE_POS_CORREO=hola@corepos.test
# Direccion del sistema, para los botones de "entrar" y "pedir mi tienda".
CORE_POS_APP_URL=http://127.0.0.1:8000
